<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login & Registration | Elite Sports Hub</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="home.css">
    <link rel="stylesheet" href="auth.css">
</head>
<body>
    <!-- Navigation Bar -->
    <section class="navbar">
        <div class="logo">
            <p>Elite Sports Hub</p>
        </div>
        <nav class="navLinks">
            <a href="Home.html">Home</a>
            <a href="About.html">About</a>
            <a href="Catalogue.html">Catalogue</a>
            <a href="Reviews.html">Reviews</a>
            <a href="Teams.html">Teams</a>
        </nav>
        
        <div class="nav-right">
            <!-- Theme Toggle Button -->
            <button id="themeToggleBtn" class="theme-toggle-btn" aria-label="Toggle Dark/Light Mode">
                <span id="themeIcon">🌙</span> <span id="themeText">Dark</span>
            </button>
            <a href="Login.html" class="button1 active-nav">Login</a>
        </div>
    </section>

    <!-- Auth Container -->
    <div class="auth-wrapper">
        <div class="auth-card">
            
            <!-- Auth Mode Switcher (Login vs Register) -->
            <div class="auth-tabs">
                <button type="button" id="tabLogin" class="tab-btn active" onclick="switchMode('login')">Sign In</button>
                <button type="button" id="tabRegister" class="tab-btn" onclick="switchMode('register')">Register Account</button>
            </div>

            <!-- LOGIN FORM -->
            <form id="loginForm" class="auth-form" novalidate>
                <h2>Welcome Back, Athlete!</h2>
                <p class="form-subtext">Access your order history and sports gear profile.</p>

                <div class="form-group">
                    <label for="loginEmail">Email Address</label>
                    <input type="email" id="loginEmail" placeholder="e.g. athlete@elitesports.com" required>
                    <span class="error-message" id="loginEmailErr">Please enter a valid email address.</span>
                </div>

                <div class="form-group">
                    <label for="loginPassword">Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="loginPassword" placeholder="Enter your password" required>
                        <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('loginPassword', this)" aria-label="Toggle password visibility">👁️</button>
                    </div>
                    <span class="error-message" id="loginPasswordErr">Password is required.</span>
                </div>

                <button type="submit" class="submit-btn">Login to Account</button>
            </form>

            <!-- MULTI-STEP REGISTER FORM -->
            <form id="registerForm" class="auth-form hidden" novalidate>
                <h2>Join Elite Sports Hub</h2>
                <p class="form-subtext">Set up your athlete account in 3 easy steps.</p>

                <!-- Step Progress Bar -->
                <div class="progress-bar-container">
                    <div class="progress-step active" id="pStep1"><span>1</span> Details</div>
                    <div class="progress-line"></div>
                    <div class="progress-step" id="pStep2"><span>2</span> Profile</div>
                    <div class="progress-line"></div>
                    <div class="progress-step" id="pStep3"><span>3</span> Interests</div>
                </div>

                <!-- Step 1: Credentials -->
                <div class="form-step step-1">
                    <h3>Step 1: Account Details</h3>
                    <div class="form-group">
                        <label for="regEmail">Email Address *</label>
                        <input type="email" id="regEmail" placeholder="yourname@domain.com">
                        <span class="error-message" id="regEmailErr">Enter a valid email address.</span>
                    </div>

                    <div class="form-group">
                        <label for="regPassword">Password *</label>
                        <div class="password-wrapper">
                            <input type="password" id="regPassword" placeholder="At least 8 chars, 1 letter & 1 number">
                            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('regPassword', this)" aria-label="Toggle password visibility">👁️</button>
                        </div>
                        <span class="error-message" id="regPasswordErr">Password must be at least 8 characters with letters & numbers.</span>
                    </div>

                    <div class="form-group">
                        <label for="regConfirmPassword">Confirm Password *</label>
                        <div class="password-wrapper">
                            <input type="password" id="regConfirmPassword" placeholder="Re-enter password">
                            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('regConfirmPassword', this)" aria-label="Toggle password visibility">👁️</button>
                        </div>
                        <span class="error-message" id="regConfirmPasswordErr">Passwords do not match.</span>
                    </div>

                    <div class="step-buttons">
                        <button type="button" class="btn-next" onclick="nextStep(1)">Next Step →</button>
                    </div>
                </div>

                <!-- Step 2: Personal Info -->
                <div class="form-step step-2 hidden">
                    <h3>Step 2: Personal Information</h3>
                    <div class="form-group">
                        <label for="regFullName">Full Name *</label>
                        <input type="text" id="regFullName" placeholder="e.g. Alex Morgan">
                        <span class="error-message" id="regFullNameErr">Full name is required.</span>
                    </div>

                    <div class="form-group">
                        <label for="regPhone">Phone Number *</label>
                        <input type="tel" id="regPhone" placeholder="e.g. +1 555-0199">
                        <span class="error-message" id="regPhoneErr">Please enter a valid phone number.</span>
                    </div>

                    <div class="step-buttons">
                        <button type="button" class="btn-prev" onclick="prevStep(2)">← Back</button>
                        <button type="button" class="btn-next" onclick="nextStep(2)">Next Step →</button>
                    </div>
                </div>

                <!-- Step 3: Sports Preferences -->
                <div class="form-step step-3 hidden">
                    <h3>Step 3: Sports & Preferences</h3>
                    <div class="form-group">
                        <label for="favSport">Primary Athletic Interest *</label>
                        <select id="favSport">
                            <option value="">Select your main sport</option>
                            <option value="basketball">Basketball 🏀</option>
                            <option value="football">Football / Soccer ⚽</option>
                            <option value="running">Running & Athletics 👟</option>
                            <option value="fitness">Gym & Fitness 🏋️‍♂️</option>
                        </select>
                        <span class="error-message" id="favSportErr">Please select your primary sport.</span>
                    </div>

                    <div class="form-group checkbox-group">
                        <label class="terms-label">
                            <input type="checkbox" id="termsCheck">
                            I agree to the Terms of Service & Privacy Policy *
                        </label>
                        <span class="error-message" id="termsCheckErr">You must accept the terms to register.</span>
                    </div>

                    <div class="step-buttons">
                        <button type="button" class="btn-prev" onclick="prevStep(3)">← Back</button>
                        <button type="submit" class="submit-btn">Complete Registration 🎉</button>
                    </div>
                </div>
            </form>

            <div id="successMessage" class="success-alert hidden">
                <p>🚀 Success! Your account has been registered. Redirecting to login...</p>
            </div>
        </div>
    </div>

    <script src="auth.js"></script>
</body>
</html>
